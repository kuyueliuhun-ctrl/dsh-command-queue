{
  "name": "dsh-command-queue",
  "version": "0.1.0",
  "description": "DSH 插件：让 /compact 等斜杠命令在 agent 忙碌时进入按 agent 串行的命令队列，空闲后自动执行；不改 DSH 源码，卸载即还原。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "slash-command",
    "queue",
    "compact"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuyueliuhun-ctrl/dsh-command-queue.git"
  },
  "homepage": "https://github.com/kuyueliuhun-ctrl/dsh-command-queue#readme",
  "bugs": {
    "url": "https://github.com/kuyueliuhun-ctrl/dsh-command-queue/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check lib/index.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
